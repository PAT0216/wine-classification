df_eda = df_merge.drop(columns=["target"])
df_info = df_eda.info()
df_info


df_summary = df_eda.describe()
df_summary


import altair as alt
alt.data_transformers.enable("vegafusion")

numeric_cols = df_eda.select_dtypes('number').columns.tolist()

hist_plot = alt.Chart(df_eda).mark_bar().encode(
    alt.X(alt.repeat()).type("quantitative").bin(maxbins=40),
    alt.Y("count()", title="Count")
).properties(
    width=120,
    height=120
).repeat(
    column=numeric_cols
)

hist_plot


















